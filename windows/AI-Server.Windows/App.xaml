<Application x:Class="AIServerWindows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#101014" />
        <SolidColorBrush x:Key="PanelBrush" Color="#181820" />
        <SolidColorBrush x:Key="Panel2Brush" Color="#20202A" />
        <SolidColorBrush x:Key="TextBrush" Color="#F2F2F5" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A5A5B0" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7C5CFF" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2A2A35" />
            <Setter Property="BorderBrush" Value="#40404D" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#20202A" />
            <Setter Property="BorderBrush" Value="#40404D" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#20202A" />
            <Setter Property="BorderBrush" Value="#40404D" />
        </Style>
    </Application.Resources>
</Application>
