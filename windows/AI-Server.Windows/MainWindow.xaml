<Window x:Class="AIServerWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI-Server"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="14">
        <Grid x:Name="LoginView">
            <Border Width="430" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource PanelBrush}" CornerRadius="18">
                <StackPanel>
                    <TextBlock Text="AI-Server" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="Windows client" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,20" />
                    <TextBlock Text="Email" Margin="4,8,4,0" />
                    <TextBox x:Name="EmailBox" />
                    <TextBlock Text="Username (registration only)" Margin="4,8,4,0" />
                    <TextBox x:Name="UsernameBox" />
                    <TextBlock Text="Password" Margin="4,8,4,0" />
                    <PasswordBox x:Name="PasswordBox" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button Content="Login" Click="Login_Click" Width="120" />
                        <Button Content="Register" Click="Register_Click" Width="120" />
                    </StackPanel>
                    <TextBlock x:Name="LoginStatus" Text="Connecting to AI-Server..." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="4,12,4,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="MainView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="22" ClipToBounds="True">
                        <Image x:Name="AiPhoto" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AiNameText" Text="AI" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="ServerStatus" Text="AI-Server" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="AiSelector" Width="190" DisplayMemberPath="AiName" SelectionChanged="AiSelector_SelectionChanged" />
                        <Button Content="+ AI" Click="CreateAi_Click" />
                        <Button Content="Settings" Click="Settings_Click" />
                        <Button Content="Logout" Click="Logout_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SettingsColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="10">
                    <Grid>
                        <ListBox x:Name="MessagesList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                                 ItemsSource="{Binding Messages}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#20202A" CornerRadius="12" Padding="12" Margin="4">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Role}" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptyChatText" Text="Start a conversation with AI" Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="14" Margin="12,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="AI Settings" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="Name" Margin="4,12,4,0" />
                            <TextBox x:Name="SettingName" />
                            <TextBlock Text="Description" Margin="4,8,4,0" />
                            <TextBox x:Name="SettingDescription" Height="70" AcceptsReturn="True" TextWrapping="Wrap" />
                            <TextBlock Text="Personality" Margin="4,8,4,0" />
                            <TextBox x:Name="SettingPersonality" Height="100" AcceptsReturn="True" TextWrapping="Wrap" />
                            <TextBlock Text="Instructions" Margin="4,8,4,0" />
                            <TextBox x:Name="SettingInstructions" Height="100" AcceptsReturn="True" TextWrapping="Wrap" />
                            <CheckBox x:Name="OnlineAiCheck" Content="Use online AI" Margin="6,12,6,4" />
                            <CheckBox x:Name="LearningCheck" Content="Learning" Margin="6,4" />
                            <CheckBox x:Name="MemoryCheck" Content="Long-term memory" Margin="6,4" />
                            <CheckBox x:Name="RelevantMemoryCheck" Content="Relevant memory" Margin="6,4" />
                            <CheckBox x:Name="AutoImagesCheck" Content="Automatic images" Margin="6,4" />
                            <Button Content="Save settings" Click="SaveSettings_Click" Margin="4,14,4,4" />
                            <Button Content="Change AI photo" Click="ChangeAiPhoto_Click" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="MessageBox" Grid.Column="0" Height="48" VerticalContentAlignment="Center"
                         KeyDown="MessageBox_KeyDown" ToolTip="Enter to send. Shift+Enter for a new line." />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Attach" Click="Attach_Click" />
                    <Button Content="Send" Click="Send_Click" Width="90" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
