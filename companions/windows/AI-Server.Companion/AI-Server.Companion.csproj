<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AI-Server.Companion</AssemblyName>
    <RootNamespace>AiServer.Companion</RootNamespace>
    <ApplicationIcon>..\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\icon.png" Link="icon.png" />
  </ItemGroup>

  <!-- The compiler requires ApplicationIcon to exist before Win32 resources are generated. -->
  <Target Name="GenerateApplicationIcon" BeforeTargets="PrepareForBuild;GenerateWin32Resources">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)GenerateIcon.ps1&quot;" />
  </Target>
</Project>