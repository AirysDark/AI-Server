<Window x:Class="AiServer.Companion.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="430" Height="360" MinWidth="360" MinHeight="280" WindowStyle="None" ResizeMode="CanResize" Topmost="True" ShowInTaskbar="True" Background="#101116" Loaded="Window_Loaded">
<Window.Resources>
 <Style TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#ff4f9a"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,8"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/></Style>
 <Style TargetType="TextBox"><Setter Property="Foreground" Value="#F5F5F7"/><Setter Property="Background" Value="#1B1D24"/><Setter Property="BorderBrush" Value="#363946"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10"/></Style>
 <Style TargetType="PasswordBox"><Setter Property="Foreground" Value="#F5F5F7"/><Setter Property="Background" Value="#1B1D24"/><Setter Property="BorderBrush" Value="#363946"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10"/></Style>
</Window.Resources>
<Grid>
 <Border CornerRadius="16" BorderBrush="#30333D" BorderThickness="1" Background="#15171D">
  <Grid Margin="14">
   <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseDown">
    <TextBlock Text="AI Server" Foreground="#ff5aa5" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
    <TextBlock x:Name="ConnectionText" Text="  • Offline" Foreground="#8F95A3" VerticalAlignment="Center" Margin="8,0,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="—" Width="34" Background="Transparent" Click="Minimize_Click"/><Button Content="×" Width="34" Background="Transparent" Click="Close_Click"/></StackPanel>
   </DockPanel>

   <Grid Grid.Row="1">
    <Grid x:Name="LoginView">
     <StackPanel VerticalAlignment="Center" MaxWidth="350">
      <TextBlock Text="Your AI companion" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,0,0,6"/>
      <TextBlock Text="Sign in to your existing AI Server account." Foreground="#9EA4B2" TextWrapping="Wrap" Margin="0,0,0,20"/>
      <TextBox x:Name="EmailBox" Height="42" Margin="0,0,0,10" ToolTip="Email"/>
      <PasswordBox x:Name="PasswordBox" Height="42" Margin="0,0,0,12"/>
      <TextBox x:Name="UsernameBox" Height="42" Margin="0,0,0,12" ToolTip="Username (only required for registration)" Visibility="Collapsed"/>
      <StackPanel Orientation="Horizontal"><Button x:Name="LoginButton" Content="Login" Width="150" Click="Login_Click"/><Button x:Name="RegisterButton" Content="Register" Width="150" Margin="10,0,0,0" Background="#30333B" Click="Register_Click"/></StackPanel>
      <Button x:Name="ToggleRegisterButton" Content="Create a new account" Background="Transparent" Foreground="#ff78b5" Click="ToggleRegister_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
      <TextBlock x:Name="LoginStatus" Foreground="#FFB36B" TextWrapping="Wrap" Margin="0,12,0,0"/>
     </StackPanel>
    </Grid>

    <Grid x:Name="MainView" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Grid.Row="0">
      <StackPanel Orientation="Horizontal"><Ellipse Width="38" Height="38" Fill="#ff4f9a"/><TextBlock x:Name="AiNameText" Text="AI" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
      <ComboBox x:Name="AiSelector" Width="150" Height="34" HorizontalAlignment="Right" SelectionChanged="AiSelector_SelectionChanged" DisplayMemberPath="AiName"/>
     </DockPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,8"><TextBlock x:Name="ChatText" Foreground="#E9EAF0" TextWrapping="Wrap" FontSize="15"/></ScrollViewer>
     <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="42"/></Grid.RowDefinitions><TextBlock x:Name="TypingText" Grid.Row="0" Foreground="#9AA0AA" Margin="4,0,0,5"/><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions><TextBox x:Name="MessageInput" Grid.Column="0" Height="42" KeyDown="MessageInput_KeyDown"/><Button Grid.Column="1" Content="Send" Margin="8,0,0,0" Click="Send_Click"/></Grid></Grid>
    </Grid>
   </Grid>
  </Grid>
 </Border>
 <Button x:Name="FloatingButton" Width="64" Height="64" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-1,-72,0,0" Visibility="Collapsed" Background="#ff4f9a" Click="FloatingButton_Click"><TextBlock Text="AI" FontWeight="Bold" Foreground="White"/></Button>
</Grid>
</Window>
