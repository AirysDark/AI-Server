<Window x:Class="AiServer.Companion.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="420" Height="280" WindowStyle="None" ResizeMode="CanResize" Topmost="True" ShowInTaskbar="True" Background="#15171C" Loaded="Window_Loaded"><Border CornerRadius="12" BorderBrush="#30343D" BorderThickness="1"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Grid.Row="0"><TextBlock x:Name="AiNameText" Text="AI" FontSize="18" FontWeight="SemiBold" Foreground="White"/><Button DockPanel.Dock="Right" Content="×" Width="32" Height="28" Click="Close_Click"/></DockPanel><ScrollViewer Grid.Row="1" Margin="0,10,0,8" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ChatText" Foreground="#E9EAF0" TextWrapping="Wrap"/></ScrollViewer><TextBlock Grid.Row="2" x:Name="TypingText" Text="" Foreground="#9AA0AA" Margin="0,0,0,6"/><Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBox x:Name="MessageInput" Grid.Column="0" Height="38" Padding="8" VerticalContentAlignment="Center" KeyDown="MessageInput_KeyDown"/><Button Grid.Column="1" Margin="8,0,0,0" Content="Send" Click="Send_Click"/></Grid></Grid></Border></Window>
